# SPDX-License-Identifier: Apache-2.0
# Render @PYTHON@, @RECONCILER@, @STATE_DIRECTORY@, and @ANCHOR_FILE@ to
# absolute paths.

[Unit]
Description=Prepare the Tacua host-ownership anchor and exact shared lock

[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0077
ExecStart=@PYTHON@ -B "@RECONCILER@" prepare-lock --state-directory "@STATE_DIRECTORY@" --anchor-file "@ANCHOR_FILE@"
TimeoutStartSec=30
NoNewPrivileges=yes
PrivateTmp=no
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
