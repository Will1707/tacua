# SPDX-License-Identifier: Apache-2.0
# Render @PYTHON@, @RECONCILER@, @STATE_DIRECTORY@, @LOCK_FILE@,
# @ANCHOR_FILE@, @OPERATION_DIRECTORY@, @CONFIG_FILE@, and
# @ADMIN_SECRET_FILE@ to absolute paths. The exact lock and anchor files must
# already exist as owner-private mode-0600 regular files.

[Unit]
Description=Tacua rootless desired-state reconciler
Documentation=https://github.com/Will1707/tacua/blob/main/services/backend/RECONCILIATION.md
After=network-online.target
Wants=network-online.target
Requires=tacua-reconcile-lock.service
After=tacua-reconcile-lock.service

[Service]
Type=oneshot
UMask=0077
ExecStart=@PYTHON@ -B "@RECONCILER@" reconcile --state-directory "@STATE_DIRECTORY@" --anchor-file "@ANCHOR_FILE@"
TimeoutStartSec=180
RuntimeMaxSec=180
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=no
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths="@STATE_DIRECTORY@" "@LOCK_FILE@"
ReadOnlyPaths="@ANCHOR_FILE@" "@OPERATION_DIRECTORY@" "@CONFIG_FILE@" "@ADMIN_SECRET_FILE@" "@RECONCILER@"
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
